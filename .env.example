# Gemini API Key (get yours from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Generator & Judge Models
GENERATOR_MODEL=gemini-3.5-flash
JUDGE_MODEL=gemini-3.1-flash-lite

# Failure threshold before reflector synthesizes an automatic generator rule
FAILURE_THRESHOLD=2

# Optional: Host & Port for web interface
WEB_HOST=127.0.0.1
WEB_PORT=8000

